{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 3000
    },
    {
      "name": "frontend-scratch-db",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend", "--", "-p", "3001"],
      "port": 3001,
      "env": {
        "DATABASE_URL": "postgres://postgres:postgres@127.0.0.1:55433/postgres",
        "PGPOOL_MAX": "1",
        "NEXT_PUBLIC_PORTAL_MODE": "full",
        "AUTH_ALLOW_DEV_LOGIN": "false"
      }
    }
  ]
}
