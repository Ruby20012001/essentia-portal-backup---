# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL 15+ with pgvector (AWS RDS in staging/production).
# Local dev without Postgres: run `npm run dev-db` in db/ and use
#   postgres://postgres:postgres@127.0.0.1:55432/postgres  with PGPOOL_MAX=1
DATABASE_URL=postgres://user:password@localhost:5432/essentia_portal
PGPOOL_MAX=10

# Dev session stub (until the auth module lands). Only the user ID is
# claimed here — access level and department always come from public.users,
# so RBAC + RLS run against database truth.
# Dev fixture CRM TL: 00000000-0000-4000-8000-000000000001 (L2, CRM_EE).
DEV_USER_ID=

# Anthropic API — Communication Spine, Knowledge Library, Priority Signals
ANTHROPIC_API_KEY=

# Microsoft Entra ID SSO (staff auth). When these are set, the login page
# offers "Sign in with Microsoft" and auth.provider can be switched to 'entra'.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Auth dev bootstrap — MUST be unset/false in production. When 'true': the
# DEV_USER_ID fallback works, /api/auth/dev-login is enabled, and the route
# gate is permissive. Production relies entirely on real sessions.
AUTH_ALLOW_DEV_LOGIN=
NODE_ENV=development

# Scheduler (auto-pilot). The external cron must present this value in the
# x-scheduler-token header to POST /api/jobs/tick. When unset (dev), the tick
# falls back to requiring an authenticated session — never anonymous.
SCHEDULER_TICK_SECRET=

# Twilio OTP (clients / vendors / external users)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# AWS S3 (VisionCAM photos)
AWS_REGION=ap-south-1
S3_BUCKET_VISIONCAM=

# Keka HRIS (org sync). When set, switch config keka.provider to 'http'.
KEKA_BASE_URL=
KEKA_API_KEY=
